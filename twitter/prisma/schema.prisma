// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                Int      @id @default(autoincrement())
  userId            Int      @map(name: "user_id")
  type              String
  provider          String
  providerAccountId String   @map(name: "provider_account_id")
  refresh_token     String?  @map(name: "refresh_token") @db.Text
  access_token      String?  @map(name: "access_token") @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map(name: "created_at")
  updatedAt         DateTime @default(now()) @map(name: "updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([providerAccountId], name: "providerAccountId")
  @@index([userId], name: "userId")
  @@map(name: "accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int      @map(name: "user_id")
  expires      DateTime
  sessionToken String   @unique @map(name: "session_token")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map(name: "sessions")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map(name: "email_verified")
  image         String?
  password      String?

  displayName     String? @map(name: "display_name")
  phoneNumber     String? @map(name: "phone_number")
  bio             String? @db.Text
  location        String?
  website         String?
  birthday        String?
  profileImageUrl String? @map(name: "profile_image_url")

  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @map(name: "updated_at")

  accounts  Account[]
  sessions  Session[]
  tweets    Tweet[]
  comments  Comment[]
  retweets  Retweet[]
  favorites Favorite[]
  following Relationship[] @relation("Follower")
  followers Relationship[] @relation("Followed")
  visitors  Notification[] @relation("Visitor")
  visiteds  Notification[] @relation("Visited")

  @@map(name: "users")
}

model VerificationRequest {
  id         Int      @id @default(autoincrement())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map(name: "verification_requests")
}

model Tweet {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @map(name: "updated_at")
  userId    Int      @map(name: "user_id")
  imageUrls String[] @map(name: "image_urls")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  comments      Comment[]
  retweets      Retweet[]
  favorites     Favorite[]
  notifications Notification[]

  @@map(name: "tweets")
}

model Comment {
  id        Int      @id @default(autoincrement())
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map(name: "created_at")
  userId    Int      @map(name: "user_id")
  tweetId   Int      @map(name: "tweet_id")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@map(name: "comments")
}

model Retweet {
  id        Int      @id @default(autoincrement())
  userId    Int      @map(name: "user_id")
  tweetId   Int      @map(name: "tweet_id")
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @default(now()) @map(name: "updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@unique([userId, tweetId])
  @@map(name: "retweets")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map(name: "user_id")
  tweetId   Int      @map(name: "tweet_id")
  createdAt DateTime @default(now()) @map(name: "created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@unique([userId, tweetId])
  @@map(name: "favorites")
}

model Relationship {
  id         Int      @id @default(autoincrement())
  followerId Int      @map(name: "follower_id")
  followedId Int      @map(name: "followed_id")
  createdAt  DateTime @default(now()) @map(name: "created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@map(name: "relationships")
}

model Notification {
  id        Int      @id @default(autoincrement())
  visitorId Int      @map(name: "visitor_id")
  visitedId Int      @map(name: "visited_id")
  tweetId   Int?     @map(name: "tweet_id")
  action    String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map(name: "created_at")

  visitor User   @relation("Visitor", fields: [visitorId], references: [id], onDelete: Cascade)
  visited User   @relation("Visited", fields: [visitedId], references: [id], onDelete: Cascade)
  tweet   Tweet? @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@map(name: "notifications")
}
